# Configuração do Banco de Dados
DATABASE_URL="postgresql://usuario:senha@host:porta/banco?sslmode=require"

# Configuração de Segurança (JWT)
JWT_SECRET="sua_chave_secreta_super_segura_aqui"
JWT_EXPIRATION="8h"
PORT=3001

# Cloudinary (upload de imagens) — obtenha no painel https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Pasta onde as imagens deste projeto ficam (isola de outros sistemas na mesma conta)
CLOUDINARY_FOLDER="la-resenha-fc"
